"""
image-tools microservice
Endpoints:
  GET  /api/health
  POST /api/remove-bg  -> PNG with transparent bg
  POST /api/compress   -> JPEG (configurable quality + optional resize)
  POST /api/process    -> JPEG with white bg + compressed (combined, what users usually want)
"""
import io
import os
import time
from flask import Flask, request, jsonify, send_file
from PIL import Image
from rembg import remove

app = Flask(__name__)
app.config['MAX_CONTENT_LENGTH'] = 50 * 1024 * 1024  # 50MB upload limit

START_TIME = time.time()

@app.route('/api/health')
def health():
    return jsonify({
        'ok': True,
        'service': 'image-tools',
        'version': '1.0.0',
        'uptime_sec': round(time.time() - START_TIME, 1),
    })

def _file_from_request():
    """Read uploaded file. Returns (bytes, filename) or (None, None)."""
    if 'file' not in request.files:
        return None, None
    f = request.files['file']
    return f.read(), f.filename

@app.route('/api/remove-bg', methods=['POST'])
def remove_bg():
    data, fname = _file_from_request()
    if not data:
        return jsonify({'error': 'no file uploaded (field name: file)'}), 400

    try:
        t0 = time.time()
        out_bytes = remove(data)
        dt = round((time.time() - t0) * 1000, 1)
        return send_file(
            io.BytesIO(out_bytes),
            mimetype='image/png',
            as_attachment=False,
            download_name=(fname or 'image').rsplit('.', 1)[0] + '-no-bg.png',
            headers={'X-Process-Time-Ms': str(dt), 'X-Original-Size': str(len(data))},
        )
    except Exception as e:
        return jsonify({'error': f'rembg failed: {str(e)}'}), 500

@app.route('/api/compress', methods=['POST'])
def compress():
    data, fname = _file_from_request()
    if not data:
        return jsonify({'error': 'no file uploaded (field name: file)'}), 400

    quality = int(request.form.get('quality', 85))
    quality = max(1, min(100, quality))
    max_width = int(request.form.get('max_width', 0))  # 0 = keep original

    try:
        t0 = time.time()
        img = Image.open(io.BytesIO(data))

        if max_width > 0 and img.width > max_width:
            ratio = max_width / img.width
            new_h = int(img.height * ratio)
            img = img.resize((max_width, new_h), Image.LANCZOS)

        # Convert to RGB for JPEG (no alpha)
        if img.mode in ('RGBA', 'LA', 'P'):
            img = img.convert('RGB')

        out = io.BytesIO()
        img.save(out, 'JPEG', quality=quality, optimize=True, progressive=True)
        out.seek(0)
        dt = round((time.time() - t0) * 1000, 1)
        return send_file(
            out,
            mimetype='image/jpeg',
            as_attachment=False,
            download_name=(fname or 'image').rsplit('.', 1)[0] + f'-q{quality}.jpg',
            headers={
                'X-Process-Time-Ms': str(dt),
                'X-Original-Size': str(len(data)),
                'X-Output-Size': str(out.tell()),
            },
        )
    except Exception as e:
        return jsonify({'error': f'compress failed: {str(e)}'}), 500

@app.route('/api/process', methods=['POST'])
def process():
    """Combined: remove bg + composite onto white + compress to JPEG.
    This is the most common case (e.g. for product photos on a white BG)."""
    data, fname = _file_from_request()
    if not data:
        return jsonify({'error': 'no file uploaded (field name: file)'}), 400

    quality = int(request.form.get('quality', 85))
    quality = max(1, min(100, quality))
    bg_color = request.form.get('bg_color', 'ffffff')  # hex, default white

    try:
        bg_rgb = tuple(int(bg_color[i:i+2], 16) for i in (0, 2, 4))
    except Exception:
        bg_rgb = (255, 255, 255)

    try:
        t0 = time.time()
        # 1) remove bg -> PNG with alpha
        nobg_bytes = remove(data)

        # 2) composite onto solid bg + convert to RGB for JPEG
        nobg_img = Image.open(io.BytesIO(nobg_bytes)).convert('RGBA')
        bg_img = Image.new('RGB', nobg_img.size, bg_rgb)
        bg_img.paste(nobg_img, mask=nobg_img.split()[3])  # alpha as mask

        out = io.BytesIO()
        bg_img.save(out, 'JPEG', quality=quality, optimize=True, progressive=True)
        out.seek(0)
        dt = round((time.time() - t0) * 1000, 1)
        return send_file(
            out,
            mimetype='image/jpeg',
            as_attachment=False,
            download_name=(fname or 'image').rsplit('.', 1)[0] + f'-processed.jpg',
            headers={
                'X-Process-Time-Ms': str(dt),
                'X-Original-Size': str(len(data)),
                'X-Output-Size': str(out.tell()),
            },
        )
    except Exception as e:
        return jsonify({'error': f'process failed: {str(e)}'}), 500

@app.errorhandler(413)
def too_large(e):
    return jsonify({'error': 'file too large (max 50MB)'}), 413

if __name__ == '__main__':
    port = int(os.environ.get('PORT', 3013))
    # Pre-warm rembg model (loads u2net weights so first request is fast)
    print('[image-tools] pre-warming rembg model...', flush=True)
    try:
        remove(b'\x89PNG\r\n\x1a\n' + b'\x00' * 100)  # dummy call to load weights
        print('[image-tools] rembg ready', flush=True)
    except Exception as e:
        print(f'[image-tools] rembg prewarm warning: {e}', flush=True)

    # Use flask dev server for simplicity. Production can switch to gunicorn later.
    app.run(host='0.0.0.0', port=port, threaded=True, debug=False)